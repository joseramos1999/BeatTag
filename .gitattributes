# Normaliza los finales de linea: en el repo siempre LF, en Windows checkout CRLF.
* text=auto

*.cs        text diff=csharp
*.axaml     text
*.csproj    text
*.sln       text eol=crlf
*.md        text
*.json      text
*.yml       text
*.yaml      text

# Los guiones de shell SIEMPRE con LF, aunque se editen desde Windows: con finales de linea de
# Windows, bash en macOS falla con un "\r: command not found" que no dice nada de lo que pasa.
*.sh        text eol=lf

# Binarios: sin conversion.
*.ico       binary
*.png       binary
*.jpg       binary
*.exe       binary
*.dll       binary
