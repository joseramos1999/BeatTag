<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>BeatTag</AssemblyName>
    <ApplicationIcon>Assets\beattag.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Publicación: UN solo .exe que funcione por sí mismo.
    - IncludeNativeLibrariesForSelfExtract: mete dentro Skia/HarfBuzz/ANGLE. Sin esto, el exe
      suelto NO arranca (le faltan los DLL nativos), que es justo lo que le pasaba a la v1.1.0.
    - EnableCompressionInSingleFile: 121 MB -> 60 MB, sin recortar código (nada que se rompa).
    - DebugType none: no arrastra los .pdb (105 MB de símbolos nativos que no pintan nada).
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Etiquetador.Core\Etiquetador.Core.csproj" />
  </ItemGroup>
</Project>
