<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="Etiquetador.App.Views.OrganizarPorGeneroView"
             x:CompileBindings="False">

    <!-- Organizar por género (B8): mueve cada canción a la carpeta de su género, con vista previa y deshacer. -->
    <DockPanel Margin="8">

        <StackPanel DockPanel.Dock="Top" Spacing="6">
            <TextBlock Classes="titulo" Text="Organizar por género" />
            <TextBlock Classes="desc"
                       Text="Mueve cada canción a una carpeta con el nombre de su género, sin tocar sus etiquetas. Primero se calcula una vista previa con adónde iría cada canción y qué se queda donde está; no se mueve nada hasta que confirmes, y todo se puede deshacer." />

            <!-- ============================ OPCIONES ============================ -->
            <Border BorderBrush="{DynamicResource BordeSuave}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,0">
                <StackPanel Spacing="4">
                    <TextBlock Text="Dónde se crean las carpetas" FontWeight="SemiBold" />
                    <RadioButton GroupName="DestinoOrganizar" IsChecked="{Binding DestinoPorGenero}" IsEnabled="{Binding Libre}"
                                 Content="En una carpeta «Por género» dentro de cada carpeta de la biblioteca (recomendado)"
                                 ToolTip.Tip="Las carpetas de los géneros no se mezclan con las que ya tienes." />
                    <RadioButton GroupName="DestinoOrganizar" IsChecked="{Binding DestinoRaiz}" IsEnabled="{Binding Libre}"
                                 Content="Directamente en cada carpeta de la biblioteca"
                                 ToolTip.Tip="Junto a las carpetas que ya hay: una carpeta que ya se llama como un género recibe las canciones de ese género." />
                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                        <RadioButton GroupName="DestinoOrganizar" IsChecked="{Binding DestinoCarpeta}" IsEnabled="{Binding Libre}"
                                     Content="En otra carpeta de la biblioteca…" VerticalAlignment="Center" />
                        <TextBox Text="{Binding CarpetaDestino}" IsReadOnly="True" PlaceholderText="Sin elegir" MinWidth="320" />
                        <Button Content="Elegir…" Click="ElegirCarpeta_Click" IsEnabled="{Binding Libre}"
                                ToolTip.Tip="Tiene que ser una carpeta de la biblioteca o estar dentro de una." />
                    </WrapPanel>

                    <TextBlock Text="Qué se mueve" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <CheckBox Content="Conservar las subcarpetas de origen dentro de cada género" IsChecked="{Binding ConservarEstructura}"
                              IsEnabled="{Binding Libre}"
                              ToolTip.Tip="Por ejemplo, «Reggaeton/Pack Enero/…» en lugar de «Reggaeton/…»." />
                    <CheckBox Content="Mover también las canciones sin género a «Sin género»" IsChecked="{Binding MoverSinGenero}"
                              IsEnabled="{Binding Libre}"
                              ToolTip.Tip="Sin marcar, las canciones sin género se quedan donde están." />
                    <CheckBox Content="Dejar en su sitio los mashups, las transiciones, las acapellas y los instrumentales" IsChecked="{Binding DejarHerramientas}"
                              IsEnabled="{Binding Libre}"
                              ToolTip.Tip="Un mashup son dos canciones, a menudo de dos estilos: su género es el que menos se puede deducir." />
                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                        <CheckBox Content="Agrupar en «Otros géneros» los que tengan menos de" IsChecked="{Binding Agrupar}"
                                  IsEnabled="{Binding Libre}" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding MinimoGrupo}" Minimum="2" Maximum="1000" Increment="1" FormatString="0" Width="120"
                                       IsEnabled="{Binding Agrupar}" />
                        <TextBlock Text="canciones" VerticalAlignment="Center" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ============================ ACCIONES ============================ -->
            <WrapPanel ItemSpacing="8" LineSpacing="6" Margin="0,4,0,0">
                <Button Content="Calcular la vista previa" Command="{Binding CalcularCommand}" IsEnabled="{Binding Libre}"
                        Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                        ToolTip.Tip="Escanea la biblioteca y calcula adónde iría cada canción. No mueve nada." />
                <Button Content="Organizar" Click="Organizar_Click" IsEnabled="{Binding PuedeOrganizar}"
                        Background="#16A34A" Foreground="White" FontWeight="SemiBold"
                        ToolTip.Tip="Mueve lo que muestra la vista previa. Nunca sobrescribe ni renombra un archivo y se puede deshacer." />
                <Button Content="Cancelar el proceso" Command="{Binding CancelarProcesoCommand}" IsVisible="{Binding ConAvance}"
                        ToolTip.Tip="Para entre un archivo y el siguiente: lo ya movido se queda y se puede deshacer." />
            </WrapPanel>

            <TextBlock Text="{Binding Resumen}" TextWrapping="Wrap" FontWeight="SemiBold" IsVisible="{Binding HayPlan}" />
            <TextBlock Text="{Binding Aviso}" TextWrapping="Wrap" IsVisible="{Binding HayAviso}" Foreground="{DynamicResource AvisoTexto}" />
            <TextBlock Text="{Binding Recomendacion}" TextWrapping="Wrap" IsVisible="{Binding HayRecomendacion}" Opacity="0.85" />

            <Border IsVisible="{Binding HayResultado}" Padding="8" CornerRadius="6"
                    Background="{DynamicResource SuperficieSuave}" BorderBrush="{DynamicResource BordeSuave}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Resultado}" TextWrapping="Wrap" />
                    <Button Content="Abrir rekordbox" Command="{Binding AbrirRekordboxCommand}"
                            ToolTip.Tip="Abre la página rekordbox para reparar las rutas de las canciones movidas." />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ============================ VISTA PREVIA ============================ -->
        <TabControl Margin="0,8,0,0" IsVisible="{Binding HayPlan}">

            <TabItem Header="{Binding TituloDestinos}">
                <DataGrid Name="TablaDestinos" ItemsSource="{Binding Destinos}" Margin="0,8,0,0"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                          DoubleTapped="Grid_DoubleTapped">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Carpeta" Binding="{Binding Nombre}" Width="*" MinWidth="200" />
                        <DataGridTextColumn Header="Canciones" Binding="{Binding CancionesTexto}" SortMemberPath="Canciones" Width="130" MinWidth="100" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100" MinWidth="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="{Binding TituloOrigenes}">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" Classes="desc" Margin="0,0,0,6"
                               Text="Cómo se reparte cada carpeta de origen. Desmarca «Incluir» para dejar donde están todas sus canciones (por ejemplo, una carpeta de uso como «WarmUp»); la vista previa se vuelve a calcular. Las subcarpetas son filas aparte." />
                    <DataGrid Name="TablaOrigenes" ItemsSource="{Binding Origenes}"
                              AutoGenerateColumns="False" SelectionMode="Single"
                              CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                              DoubleTapped="Grid_DoubleTapped">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Incluir" Width="70" MinWidth="60" SortMemberPath="Incluir">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Incluir}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Carpeta" Binding="{Binding Nombre}" IsReadOnly="True" Width="260" MinWidth="140" />
                            <DataGridTextColumn Header="Canciones" Binding="{Binding Total}" IsReadOnly="True" Width="90" MinWidth="80" />
                            <DataGridTextColumn Header="Se mueven" Binding="{Binding SeMueven}" IsReadOnly="True" Width="95" MinWidth="80" />
                            <DataGridTextColumn Header="Se quedan" Binding="{Binding SeQuedan}" IsReadOnly="True" Width="95" MinWidth="80" />
                            <DataGridTextColumn Header="Reparto" Binding="{Binding Reparto}" IsReadOnly="True" Width="*" MinWidth="200" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="{Binding TituloOmitidas}">
                <DataGrid Name="TablaOmitidas" ItemsSource="{Binding Omitidas}" Margin="0,8,0,0"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                          DoubleTapped="Grid_DoubleTapped">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Archivo" Binding="{Binding Archivo}" Width="300" MinWidth="140" />
                        <DataGridTextColumn Header="Motivo" Binding="{Binding Texto}" Width="320" MinWidth="160" />
                        <DataGridTextColumn Header="Carpeta" Binding="{Binding Carpeta}" Width="*" MinWidth="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
