<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Etiquetador.App.ViewModels"
        xmlns:views="using:Etiquetador.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="Etiquetador.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/beattag.ico"
        Title="BeatTag — Etiquetador DJ" Width="1000" Height="640">

    <TabControl SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem Header="Biblioteca">
            <views:LibraryView DataContext="{Binding Library}" />
        </TabItem>
        <TabItem Header="Enriquecer">
            <views:EnrichView DataContext="{Binding Enrich}" />
        </TabItem>
        <TabItem Header="Editor">
            <views:EditorView DataContext="{Binding Editor}" />
        </TabItem>
        <TabItem Header="Duplicados">
            <views:DuplicatesView DataContext="{Binding Duplicates}" />
        </TabItem>
        <TabItem Header="Calidad">
            <views:QualityView DataContext="{Binding Quality}" />
        </TabItem>
        <TabItem Header="Incompletas">
            <views:IncompleteView DataContext="{Binding Incomplete}" />
        </TabItem>
        <TabItem Header="No encontradas">
            <views:NotFoundView DataContext="{Binding NotFound}" />
        </TabItem>
        <TabItem Header="Estadísticas">
            <views:StatsView DataContext="{Binding Stats}" />
        </TabItem>
        <TabItem Header="🌍 Tendencias">
            <views:TrendsView DataContext="{Binding Trends}" />
        </TabItem>
        <TabItem Header="🔊 Volumen">
            <views:LoudnessView DataContext="{Binding Loudness}" />
        </TabItem>
        <TabItem Header="Ajustes">
            <views:SettingsView DataContext="{Binding Settings}" />
        </TabItem>
        <TabItem Header="ℹ Ayuda">
            <views:HelpView />
        </TabItem>
    </TabControl>
</Window>
