<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Etiquetador.App.ViewModels"
        xmlns:views="using:Etiquetador.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
        x:Class="Etiquetador.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/beattag.ico"
        MinWidth="820" MinHeight="520"
        Title="BeatTag — Etiquetador DJ" Width="1100" Height="680">

    <DockPanel>

        <!--
            Aviso de bloqueo. Mientras hay un proceso en marcha, las demás pestañas se deshabilitan:
            tocar archivos que otro proceso está usando hace fallar la operación. La pestaña que
            trabaja sigue activa para poder ver el avance y cancelar.
        -->
        <Border DockPanel.Dock="Bottom" IsVisible="{Binding Busy}"
                Background="{DynamicResource AvisoFondo}" BorderBrush="{DynamicResource AvisoBorde}"
                BorderThickness="0,1,0,0" Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="⏳" VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource AvisoTexto}" TextWrapping="Wrap"
                           Text="{Binding BusyWhat, StringFormat='Proceso en curso en «{0}». El resto de la aplicación permanece bloqueado hasta que termine, para no alterar archivos que se están usando.'}" />
            </StackPanel>
        </Border>

        <!--
            Primeros pasos. Sin biblioteca preparada, las pestañas que trabajan sobre ella quedan
            fuera de alcance; sin este aviso el usuario solo vería la mayoría en gris sin saber
            por qué. Siguen accesibles Biblioteca, Ajustes y Ayuda.
        -->
        <Border DockPanel.Dock="Bottom" IsVisible="{Binding ShowSetupHint}"
                Background="{DynamicResource InfoFondo}" BorderBrush="{DynamicResource InfoBorde}"
                BorderThickness="0,1,0,0" Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="👋" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SetupHint}" VerticalAlignment="Center"
                           Foreground="{DynamicResource InfoTexto}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--
            Barra de estado. Lo que la página abierta tenga que contar sale SIEMPRE aquí, en vez de
            en un sitio distinto según la pestaña.
        -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SuperficieSuave}"
                BorderBrush="{DynamicResource BordeSuave}" BorderThickness="0,1,0,0" Padding="10,5">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding PaginaActual}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding EstadoPagina}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextoSecundario}" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding EstadoPagina}" />
                <ProgressBar Grid.Column="2" Width="150" Height="6" VerticalAlignment="Center"
                             Minimum="0" Maximum="100" Value="{Binding ProgresoPagina}"
                             IsVisible="{Binding HayBarraProgreso}" Margin="10,0,0,0" />
            </Grid>
        </Border>

        <!--
            Barra lateral. Trece destinos en una fila de pestañas no se leen; agrupados por lo que
            uno viene a hacer, sí. Los bloques y su contenido salen de MainViewModel.Grupos, que es
            también de donde sale el nombre para el aviso de «proceso en curso»: una sola lista.
        -->
        <Border DockPanel.Dock="Left" Background="{DynamicResource NavFondo}"
                BorderBrush="{DynamicResource BordeSuave}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- 190 y no 182: los botones ganaron margen propio, y el nombre necesita el mismo sitio de antes. -->
                <ItemsControl ItemsSource="{Binding Grupos}" Width="190" Margin="4,6,4,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:GrupoNav">
                            <StackPanel>
                                <TextBlock Classes="grupo" Text="{Binding Titulo}"
                                           IsVisible="{Binding TieneTitulo}" />
                                <!-- El bloque sin título (Ajustes y Ayuda) va separado por una línea. -->
                                <Separator Margin="10,10,10,6" IsVisible="{Binding !TieneTitulo}"
                                           Background="{DynamicResource BordeSuave}" />
                                <ItemsControl ItemsSource="{Binding Paginas}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:PaginaNav">
                                            <Button Classes="nav" Classes.activa="{Binding Activa}"
                                                    IsEnabled="{Binding Habilitada}"
                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).IrACommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="9">
                                                    <TextBlock Text="{Binding Icono}" FontSize="14" Width="18" />
                                                    <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!--
            El contenido. Cada página se construye la PRIMERA VEZ que se abre (ver MainWindow.axaml.cs)
            y a partir de ahí vive a la vez que las demás, mostrándose solo la activa: cada una guarda
            estado que no está en su ViewModel -posición de la tabla, selección, grupos desplegados-
            y volver a crearla en cada salto lo perdería.
        -->
        <Grid Name="Contenido" />
    </DockPanel>
</Window>
