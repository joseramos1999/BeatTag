<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="520"
        x:Class="Etiquetador.App.Views.RestoreIgnoredDialog"
        x:CompileBindings="False"
        Title="Recuperar canciones descartadas"
        Width="620" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="18" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="6">
            <TextBlock Text="Canciones descartadas" FontSize="16" FontWeight="Bold" />
            <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12"
                       Text="Son las que quitaste de la lista en Enriquecer o en No encontradas. Marca las que quieras volver a tener en cuenta y vuelve a analizar para verlas." />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <TextBox x:Name="FilterBox" PlaceholderText="Buscar…" Width="220" TextChanged="Filter_Changed" />
                <Button Content="Marcar todo" Click="MarkAll_Click" />
                <Button Content="Desmarcar todo" Click="MarkNone_Click" />
                <TextBlock x:Name="CountText" Foreground="Gray" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,12,0,0">
            <Button Content="Cancelar" Click="Cancel_Click" />
            <Button x:Name="RestoreBtn" Content="Recuperar las marcadas" Click="Restore_Click"
                    Background="#16A34A" Foreground="White" FontWeight="SemiBold" />
        </StackPanel>

        <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="4" Margin="0,10,0,0">
            <ScrollViewer>
                <ItemsControl x:Name="List" Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Marcada}" Margin="0,1"
                                      Content="{Binding FileName}" ToolTip.Tip="{Binding FilePath}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

    </DockPanel>
</Window>
