<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Etiquetador.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="560"
             x:Class="Etiquetador.App.Views.DuplicatesView"
             x:DataType="vm:DuplicatesViewModel">

    <DockPanel Margin="8">

        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
            <TextBlock Classes="titulo" Text="Duplicados" />
            <TextBlock Classes="desc"
                       Text="Localiza canciones repetidas aunque el nombre del archivo no coincida. La copia que conviene conservar aparece en verde; puedes marcar el resto y enviarlas a la papelera de una vez." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <Button Content="Analizar" Command="{Binding AnalyzeCommand}" IsEnabled="{Binding !IsBusy}"
                    Background="#2563EB" Foreground="White" FontWeight="SemiBold" />
            <TextBlock Text="Agrupar por" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode}" MinWidth="230" />
            <TextBlock Text="Conservar" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding KeepOptions}" SelectedItem="{Binding SelectedKeep}" MinWidth="230"
                      ToolTip.Tip="Qué copia se considera la mejor de cada grupo. Es la que se marca en verde y la que no se marca al pulsar «Marcar sobrantes»." />
            <Button Content="⯆ Desplegar" Click="ExpandAll_Click" />
            <Button Content="⯈ Cerrar" Click="CollapseAll_Click" />
            <TextBox Text="{Binding Busqueda}" PlaceholderText="Buscar…" Width="180"
                     ToolTip.Tip="Filtra por archivo, carpeta o grupo. Se muestran los GRUPOS completos que contengan alguna coincidencia: un duplicado solo significa algo al lado de su pareja." />
            <TextBlock Text="{Binding FiltroInfo}" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <!-- Carpetas: prioritaria = de ahí sale la copia buena; excluida = ni se mira. -->
        <Expander DockPanel.Dock="Top" Header="{Binding ResumenCarpetas}" Margin="0,0,0,6">
            <StackPanel Spacing="4" Margin="4">
                <TextBlock Classes="desc"
                           Text="Marca como prioritaria la carpeta donde vive tu colección buena: ante dos copias iguales se conservará la de ahí. Excluye las que no quieras que participen, como acapellas o packs de remezclas." />
                <!-- El ItemsControl no se desplaza por su cuenta: sin este ScrollViewer las carpetas
                     que pasan del alto quedan recortadas y no hay forma de llegar a ellas. -->
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="110,110,*" Margin="0,1">
                                    <CheckBox Grid.Column="0" Content="Prioritaria" IsChecked="{Binding Prioritaria}" />
                                    <CheckBox Grid.Column="1" Content="Excluir"     IsChecked="{Binding Excluida}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Path}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Expander>

        <!-- Huellas: solo aparece con el criterio de audio, que es el unico que las necesita. -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding EsPorHuella}" Margin="0,0,0,6" Padding="8,6"
                Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="4">
            <StackPanel Spacing="4">
                <TextBlock Classes="desc" Margin="0"
                           Text="Compara el AUDIO, así que encuentra la misma canción aunque tenga títulos distintos o no esté etiquetada. Hay que analizar antes cada archivo: la primera vez tarda un buen rato, pero queda guardado y las siguientes son inmediatas." />
                <TextBlock Foreground="#B45309" TextWrapping="Wrap" FontSize="12"
                           Text="Tus ediciones de DJ (Aca Out, Melodic Intro, Extended…) comparten el audio del original, así que aparecen en el mismo grupo. Cada una conserva su propio ejemplar y «Marcar sobrantes» respeta esa distinción: solo marca copias de la MISMA versión. Aun así, revisa antes de enviar nada a la papelera." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Analizar audio" Command="{Binding ScanFingerprintsCommand}" IsEnabled="{Binding !FpBusy}"
                            Background="#7C3AED" Foreground="White" FontWeight="SemiBold" />
                    <Button Content="Cancelar" Command="{Binding CancelFingerprintsCommand}" IsVisible="{Binding FpBusy}"
                            Background="#DC2626" Foreground="White" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ResumenHuellas}" Foreground="Gray" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding FpProgress}" Height="6" IsVisible="{Binding FpBusy}" />
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <Button Content="Marcar sobrantes" Command="{Binding MarkAllButBestCommand}"
                    Background="#D97706" Foreground="White" FontWeight="SemiBold"
                    ToolTip.Tip="Marca todas las copias menos la mejor de cada grupo, de modo que siempre queda un ejemplar de cada canción." />
            <Button Content="Quitar marcas" Command="{Binding ClearMarksCommand}"
                    Background="#6B7280" Foreground="White" FontWeight="SemiBold" />
            <Button Content="🗑 Enviar marcadas a la papelera" Click="TrashMarked_Click"
                    Background="#DC2626" Foreground="White" FontWeight="SemiBold"
                    ToolTip.Tip="Los archivos van a la Papelera de Windows, así que se pueden recuperar desde ahí." />
            <TextBlock VerticalAlignment="Center" Foreground="Gray"
                       Text="{Binding Marcadas, StringFormat='{}{0} marcadas'}" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!--
          La tabla se ha quedado vieja porque la biblioteca cambió desde otra pestaña. Comparar el
          audio otra vez es carísimo, así que no se hace solo: se avisa y decide el usuario.
        -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding Desactualizada}" Margin="0,0,0,6"
                Background="#33D97706" BorderBrush="#D97706" BorderThickness="1" CornerRadius="4" Padding="10,6">
            <TextBlock TextWrapping="Wrap"
                       Text="⚠ La biblioteca ha cambiado desde el último análisis, así que estos grupos pueden estar desfasados. Pulsa Analizar para volver a comparar el audio." />
        </Border>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" Margin="0,0,0,6" />

        <!-- IsReadOnly="False" solo para que la casilla se pueda pulsar; las columnas de datos van
             marcadas una a una como solo lectura. Es el mismo montaje que usa Enriquecer. -->
        <DataGrid Name="Grid" ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}"
                  x:CompileBindings="False" AutoGenerateColumns="False" IsReadOnly="False"
                  CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                  PointerPressed="Grid_PointerPressed" DoubleTapped="Grid_DoubleTapped"
                  CellEditEnded="Cell_EditEnded">
            <DataGrid.Styles>
                <Style Selector="DataGridRow">
                    <Setter Property="Background" Value="{Binding Fondo}" />
                </Style>
            </DataGrid.Styles>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Escuchar / Parar" Command="{Binding PlayPreviewCommand}" />
                    <MenuItem Header="Abrir carpeta contenedora" Command="{Binding OpenContainingFolderCommand}" />
                    <MenuItem Header="Enviar a la papelera" Command="{Binding SendToRecycleBinCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Borrar" Binding="{Binding Marcada}" Width="70" MinWidth="60" />
                <DataGridTextColumn Header="Archivo" Binding="{Binding FileName}" Width="2*" MinWidth="140" IsReadOnly="True" />
                <DataGridTextColumn Header="Versión" Binding="{Binding Version}" Width="140" MinWidth="90" IsReadOnly="True" />
                <DataGridTextColumn Header="Conservar" Binding="{Binding Motivo}" Width="170" MinWidth="110" IsReadOnly="True" />
                <DataGridTextColumn Header="Calidad" Binding="{Binding Quality}" Width="90" MinWidth="70" IsReadOnly="True" />
                <DataGridTextColumn Header="Dur." Binding="{Binding Duration}" Width="70" MinWidth="55" IsReadOnly="True" />
                <DataGridTextColumn Header="Carpeta" Binding="{Binding Folder}" Width="2*" MinWidth="120" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
