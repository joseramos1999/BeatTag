<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Etiquetador.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="560"
             x:Class="Etiquetador.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <!-- Encabezado de sección -->
        <Style Selector="TextBlock.sec">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <!-- Texto explicativo bajo el encabezado -->
        <Style Selector="TextBlock.ayuda">
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="Button.gris">
            <Setter Property="Background" Value="#6B7280" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,*" Margin="12">
        <!-- Columna izquierda: los ajustes son ya bastantes, así que va con desplazamiento propio. -->
        <ScrollViewer Grid.Column="0" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="6">

                <TextBlock Classes="titulo" Text="Ajustes" />
                <TextBlock Classes="desc" Margin="0,0,0,6"
                           Text="Configuración de la aplicación: el aspecto, la IA local, las claves de las fuentes musicales, las listas de nombres de artista y el mantenimiento de los datos guardados." />

                <!-- Lo que pasó al leer config.net.json (apartado por ilegible, ajustes descartados, no se
                     guardará en esta sesión…). Antes solo quedaba en el registro. -->
                <Border IsVisible="{Binding AvisoConfiguracion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Padding="8,6" Margin="0,0,0,6"
                        Background="{DynamicResource AvisoFondo}" BorderBrush="{DynamicResource AvisoBorde}" BorderThickness="1" CornerRadius="4">
                    <TextBlock Foreground="{DynamicResource AvisoTexto}" TextWrapping="Wrap" FontSize="12" Text="{Binding AvisoConfiguracion}" />
                </Border>
                <Border IsVisible="{Binding AvisoCredenciales, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Padding="8,6" Margin="0,0,0,6"
                        Background="{DynamicResource AvisoFondo}" BorderBrush="{DynamicResource AvisoBorde}" BorderThickness="1" CornerRadius="4">
                    <StackPanel Spacing="6">
                        <TextBlock Foreground="{DynamicResource AvisoTexto}" TextWrapping="Wrap" FontSize="12" Text="{Binding AvisoCredenciales}" />
                        <Button Content="Olvidar credenciales ilegibles" Click="ForgetUnreadableCredentials_Click" Classes="gris" HorizontalAlignment="Left"
                                ToolTip.Tip="Las borra de la configuración. Mientras no lo hagas, se conservan cifradas tal cual por si vuelves a abrir la configuración en el equipo donde se guardaron." />
                    </StackPanel>
                </Border>

                <!-- ================= ASPECTO ================= -->
                <TextBlock Classes="sec" Text="Aspecto" />
                <TextBlock Classes="ayuda"
                           Text="Se aplica al momento y se recuerda. La ventana también guarda su tamaño y su posición al cerrarla." />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Tema" VerticalAlignment="Center" Width="60" />
                    <ComboBox ItemsSource="{Binding Temas}" SelectedItem="{Binding Tema}" MinWidth="180"
                              ToolTip.Tip="«Como el sistema» sigue a Windows o macOS. Forzarlo sirve para pinchar de noche sin que el sistema te encienda la pantalla en blanco por la mañana." />
                </StackPanel>

                <CheckBox Content="Tablas compactas" IsChecked="{Binding TablasCompactas}"
                          ToolTip.Tip="Filas más juntas: caben bastantes más canciones en pantalla, a costa de leerse algo más apretado." />

                <!-- ================= IA LOCAL ================= -->
                <TextBlock Classes="sec" Text="IA local" Margin="0,0,0,0" />
                <TextBlock Classes="ayuda"
                           Text="Se ejecuta en tu equipo mediante Ollama: no necesita clave y no envía información a ningún servicio externo. Ayuda a interpretar nombres de archivo muy alterados (etiquetas de pool, BPM, tonalidad) para poder buscarlos en el catálogo. Es opcional: si no la instalas, el resto del análisis funciona igual." />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Instalar Ollama" Command="{Binding InstallAiCommand}" IsEnabled="{Binding !IaOcupada}"
                            Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                            ToolTip.Tip="Lo instala con el gestor de paquetes del sistema: winget en Windows, que pedirá confirmación de administrador, y Homebrew en macOS. Puedes seguir usando la aplicación mientras tanto." />
                    <Button Content="Detectar" Command="{Binding DetectAiCommand}" IsEnabled="{Binding !IaOcupada}" Classes="gris"
                            ToolTip.Tip="Comprueba si Ollama está en marcha y lista los modelos instalados." />
                    <Button Content="Descargar modelo" Command="{Binding PullModelCommand}" IsEnabled="{Binding !IaOcupada}" Classes="gris"
                            ToolTip.Tip="Descarga en tu equipo el modelo seleccionado. Son varios GB y solo hace falta una vez. Puedes seguir usando la aplicación mientras tanto, o cancelarla." />
                    <!-- Instalar y descargar ya no bloquean la aplicación: se pueden detener desde aquí. -->
                    <Button Content="Cancelar" Command="{Binding CancelarIaCommand}" IsVisible="{Binding IaEnSegundoPlano}"
                            Background="#DC2626" Foreground="White" FontWeight="SemiBold"
                            ToolTip.Tip="Detiene la instalación o la descarga en curso." />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Modelo" VerticalAlignment="Center" Width="60" />
                    <ComboBox ItemsSource="{Binding AiOpciones}" SelectedItem="{Binding AiModel}"
                              MinWidth="220" IsEnabled="{Binding !IaOcupada}"
                              ToolTip.Tip="Primero los modelos instalados; después los recomendados, que hay que descargar." />
                    <TextBlock Text="{Binding AiModelNota}" Foreground="{DynamicResource TextoSecundario}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Dirección" VerticalAlignment="Center" Width="60" />
                    <TextBox Text="{Binding AiHost}" Width="240" PlaceholderText="http://localhost:11434"
                             ToolTip.Tip="Solo hace falta cambiarlo si Ollama no está en este equipo o usa otro puerto." />
                </StackPanel>

                <ProgressBar Minimum="0" Maximum="100" Value="{Binding AiProgress}" Height="8"
                             IsVisible="{Binding AiShowProgress}" />
                <TextBlock Text="{Binding AiStatus}" Foreground="{DynamicResource TextoSecundario}" TextWrapping="Wrap" />

                <!-- ================= CLAVES ================= -->
                <TextBlock Classes="sec" Text="Claves de API" />
                <TextBlock Classes="ayuda"
                           Text="Deezer y Apple Music funcionan sin ninguna clave. Las demás fuentes son opcionales y mejoran los resultados. Se guardan cifradas y ligadas a tu usuario (DPAPI en Windows, el Llavero en macOS): nadie más puede leerlas en este equipo. Cada clave viaja únicamente al servicio al que pertenece, que es para lo que sirve." />

                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" >
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Spotify Client ID" VerticalAlignment="Center" Margin="0,2" />
                    <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding SpotifyId}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Spotify Client Secret" VerticalAlignment="Center" Margin="0,2" />
                    <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding SpotifySecret}" PasswordChar="•" Margin="0,2" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Token de Discogs" VerticalAlignment="Center" Margin="0,2" />
                    <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding DiscogsToken}" PasswordChar="•" Margin="0,2" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Clave de AcoustID" VerticalAlignment="Center" Margin="0,2" />
                    <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding AcoustIdKey}" PasswordChar="•" Margin="0,2" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Clave de AudD" VerticalAlignment="Center" Margin="0,2" />
                    <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding AuddToken}" PasswordChar="•" Margin="0,2"
                               ToolTip.Tip="Para la pestaña Comprobar audio. Se obtiene en dashboard.audd.io; las primeras 300 consultas son gratuitas." />
                </Grid>

                <!-- ================= NOMBRES DE ARTISTA ================= -->
                <TextBlock Classes="sec" Text="Nombres de artista" />
                <TextBlock Classes="ayuda"
                           Text="Dos listas que puedes ampliar. Los alias agrupan nombres distintos de un mismo artista, para que una coincidencia correcta no se descarte (por ejemplo, Cruz Cafuné aparece en el catálogo como Cruzzi). Las grafías fijan cómo debe escribirse un nombre. Se aplican al arrancar la aplicación." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Alias de artista" Command="{Binding OpenAliasesFileCommand}" Classes="gris"
                            ToolTip.Tip="Abre la carpeta con ArtistAliases.json. Formato: [[&quot;Nombre bueno&quot;, &quot;alias&quot;]]. El primero es el que se escribe." />
                    <Button Content="Grafías especiales" Command="{Binding OpenExceptionsFileCommand}" Classes="gris"
                            ToolTip.Tip="Abre la carpeta con ArtistsExceptions.json: nombres cuya escritura no debe alterarse (deadmau5, AC/DC…)." />
                </StackPanel>

                <!-- ================= REKORDBOX ================= -->
                <TextBlock Classes="sec" Text="rekordbox" />
                <!-- La reparación está en la página rekordbox (equipo «rekordbox», tanda 4); aquí queda el acceso. -->
                <TextBlock Classes="ayuda"
                           Text="rekordbox guarda los cue points y el beatgrid en su base de datos, ligados a la ruta del archivo. Al renombrar o mover un archivo, los da por perdidos. La reparación de la colección está en la página rekordbox: abre allí la colección exportada (Archivo → Exportar colección en formato xml) y BeatTag busca cada entrada rota en la biblioteca, por los renombrados que tiene anotados y por nombre de archivo, tamaño y duración. Se escribe un XML nuevo para importar; ni el exportado ni la base de datos de rekordbox se tocan." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Reparar colección de rekordbox" Command="{Binding AbrirRekordboxCommand}"
                            Background="#0D9488" Foreground="White" FontWeight="SemiBold"
                            ToolTip.Tip="Abre la página rekordbox, donde se comprueba y se repara la colección exportada." />
                    <TextBlock Text="{Binding RenombradosAnotados, StringFormat='{}{0} renombrados que se pueden reparar'}"
                               Foreground="{DynamicResource TextoSecundario}" VerticalAlignment="Center"
                               ToolTip.Tip="Archivos que BeatTag renombró y que siguen con el nombre nuevo. No cuenta los renombrados que se deshicieron." />
                </StackPanel>

                <!-- ================= ISRC (equipo catalogo_bandeja, C14) ================= -->
                <TextBlock Classes="sec" Text="Código ISRC" />
                <TextBlock Classes="ayuda"
                           Text="El ISRC es el código internacional que identifica una grabación concreta. Deezer lo facilita cuando identifica una canción, sin consultas adicionales. Si activas esta opción, al aplicar una propuesta se escribe en el archivo, solo si el archivo no tiene ya uno y solo cuando es exactamente la grabación del catálogo: en un remix, una extended o una edición de DJ sería el código de otra grabación. Se puede deshacer como el resto de cambios." />
                <CheckBox Content="Escribir el ISRC al aplicar propuestas" IsChecked="{Binding EscribirIsrc}"
                          ToolTip.Tip="En MP3, AIFF y WAV va en el campo TSRC; en FLAC y OGG, en ISRC; en M4A, en su campo equivalente. Se aplica al momento." />

                <!-- ================= MANTENIMIENTO ================= -->
                <TextBlock Classes="sec" Text="Mantenimiento" />
                <CheckBox Content="Usar caché de respuestas (recomendado)" IsChecked="{Binding Cache}"
                          ToolTip.Tip="Guarda las respuestas de las fuentes para que volver a analizar sea inmediato." />
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                    <Button Content="Vaciar caché" Click="ClearCache_Click" IsEnabled="{Binding !IsBusy}" Classes="gris"
                            ToolTip.Tip="Borra las respuestas guardadas de los catálogos y las cachés de escaneo y de análisis, después de confirmar. El siguiente escaneo y el siguiente análisis tardarán bastante más." />
                    <Button Content="Recuperar descartadas" Command="{Binding RestoreIgnoredCommand}" Classes="gris"
                            ToolTip.Tip="Vuelve a tener en cuenta las canciones que quitaste de la lista en Enriquecer." />
                    <Button Content="Olvidar aplicadas" Click="ForgetApplied_Click" Classes="gris"
                            ToolTip.Tip="Las canciones ya aplicadas no vuelven a proponerse al Analizar. Esto borra esa marca, después de confirmar." />
                    <Button Content="📁 Ver logs" Command="{Binding OpenLogFolderCommand}" Classes="gris"
                            ToolTip.Tip="Abre la carpeta de registros con el archivo de esta sesión (traza detallada de cada canción)." />
                    <Button Content="📂 Carpeta de datos" Command="{Binding OpenDataFolderCommand}" Classes="gris"
                            ToolTip.Tip="Abre la carpeta de Documentos donde la aplicación guarda todo." />
                    <Button Content="🧹 Limpiar carpeta de datos" Click="CleanData_Click"
                            Background="#B45309" Foreground="White" FontWeight="SemiBold"
                            ToolTip.Tip="Borra registros, informes y cachés. No toca los ajustes, las listas de artista ni el historial para deshacer." />
                </WrapPanel>

                <!-- ================= PENDIENTES (equipo «listas», tanda 3) ================= -->
                <TextBlock Classes="sec" Text="Pendientes" />
                <TextBlock Classes="ayuda"
                           Text="«Buscar en mi pool» abre en el navegador la búsqueda de la canción en el pool de música donde descargas. Escribe la dirección de búsqueda de tu pool poniendo {q} donde va lo que se busca: BeatTag lo sustituye por el artista principal y el título. Para encontrarla, busca cualquier canción en la web del pool, copia la dirección de la página de resultados y cambia lo que buscaste por {q}. BeatTag no inicia sesión en el pool ni lee nada de él: el navegador usa tu sesión." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Búsqueda" VerticalAlignment="Center" Width="60" />
                    <TextBox Text="{Binding PoolBusquedaUrl}" Width="320" PlaceholderText="{Binding EjemploPoolBusqueda}"
                             LostFocus="PoolBusqueda_LostFocus"
                             ToolTip.Tip="Por ejemplo, https://www.mipool.com/search?q={q}. Se guarda al salir de la casilla." />
                    <Button Content="Probar" Command="{Binding ProbarPoolBusquedaCommand}" Classes="gris"
                            ToolTip.Tip="Abre en el navegador la búsqueda de una canción de ejemplo, para comprobar que la dirección lleva a los resultados de tu pool." />
                </StackPanel>
                <TextBlock Text="{Binding AvisoPoolBusqueda}" Foreground="{DynamicResource AvisoTexto}" TextWrapping="Wrap" FontSize="12"
                           IsVisible="{Binding AvisoPoolBusqueda, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- ================= ACCIONES ================= -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                    <Button Content="Guardar" Command="{Binding SaveCommand}"
                            Background="#16A34A" Foreground="White" FontWeight="SemiBold" />
                    <Button Content="Probar conexión" Command="{Binding TestConnectionCommand}" IsEnabled="{Binding !IsBusy}"
                            Background="#2563EB" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>

                <TextBlock Text="Resultado de la prueba" FontWeight="Bold" Margin="0,10,0,0" />
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8" MinHeight="90">
                    <ScrollViewer>
                        <SelectableTextBlock Text="{Binding TestReport}" FontFamily="Consolas,monospace" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                <TextBlock Text="Registro" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                <CheckBox Content="Solo lo importante" IsChecked="{Binding SoloImportante}" VerticalAlignment="Center"
                          ToolTip.Tip="Deja únicamente errores, avisos y resúmenes. En una tirada larga pasan miles de líneas de detalle." />
                <CheckBox Name="AutoScroll" Content="Seguir el final" IsChecked="True" VerticalAlignment="Center"
                          ToolTip.Tip="Mantiene a la vista la última línea. Desmárcalo para poder leer hacia atrás sin que salte." />
                <Button Content="Copiar" Click="CopyLog_Click" Classes="gris"
                        ToolTip.Tip="Copia al portapapeles lo que se ve, para pegarlo donde haga falta." />
                <Button Content="Limpiar" Command="{Binding ClearLogCommand}" Classes="gris" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding LogFilePath}" Foreground="{DynamicResource TextoSecundario}" FontSize="11"
                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                       ToolTip.Tip="Archivo de registro de esta sesión. Contiene mucho más detalle que lo que cabe en pantalla." />

            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                <ListBox Name="LogList" ItemsSource="{Binding Log}" FontFamily="Consolas,monospace" FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Hora}" Foreground="{DynamicResource TextoSecundario}" />
                                <TextBlock Text="{Binding Message}" Foreground="{Binding Color}"
                                           FontWeight="{Binding Peso}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
