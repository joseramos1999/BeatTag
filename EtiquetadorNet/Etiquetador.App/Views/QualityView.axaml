<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Etiquetador.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="560"
             x:Class="Etiquetador.App.Views.QualityView"
             x:DataType="vm:QualityViewModel">

    <DockPanel Margin="8">

        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
            <TextBlock Classes="titulo" Text="Calidad de audio" />
            <TextBlock Classes="desc"
                       Text="Ordena las grabaciones por calidad para localizar las que están en baja resolución y convendría reemplazar. En un equipo de sonido grande la diferencia se nota." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,6">
            <Button Content="Analizar" Command="{Binding AnalyzeCommand}" IsEnabled="{Binding !IsBusy}"
                    Background="#2563EB" Foreground="White" FontWeight="SemiBold" />
            <CheckBox Content="Solo baja calidad" IsChecked="{Binding OnlyPoor}" VerticalAlignment="Center" />
            <Button Content="⯆ Desplegar" Click="ExpandAll_Click" />
            <Button Content="⯈ Cerrar" Click="CollapseAll_Click" />
            <TextBox Text="{Binding Busqueda}" PlaceholderText="Buscar…" Width="180"
                     ToolTip.Tip="Filtra por archivo, carpeta o calidad. Por palabras sueltas y en cualquier orden. Se combina con «solo baja calidad» y «solo sospechosos»." />
            <TextBlock Text="{Binding FiltroInfo}" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <!-- Calidad real por espectro (P4, equipo audio_medido). -->
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Analizar calidad real" Command="{Binding AnalizarEspectroCommand}" IsEnabled="{Binding !IsBusy}"
                        Background="#7C3AED" Foreground="White" FontWeight="SemiBold"
                        ToolTip.Tip="Mide hasta qué frecuencia llega el audio de cada archivo, a partir de tres fragmentos de 10 segundos. Los resultados se guardan: las siguientes veces solo se analizan los archivos nuevos o modificados. No se modifica ningún archivo." />
                <Button Content="Cancelar" Command="{Binding CancelarEspectroCommand}" IsVisible="{Binding AnalizandoEspectro}" />
                <CheckBox Content="Solo sospechosos" IsChecked="{Binding SoloSospechosos}" VerticalAlignment="Center"
                          ToolTip.Tip="Muestra solo los archivos cuyo audio termina muy por debajo de lo que corresponde a su formato o a su tasa de bits declarada: por ejemplo, un archivo de 320 kbps cuyo audio se corta hacia 16 kHz, como el de uno de 128 kbps." />
            </StackPanel>
            <TextBlock Classes="desc" TextWrapping="Wrap"
                       Text="La calidad real se estima por el espectro: cada codificador con pérdida elimina los agudos por encima de una frecuencia que depende de la tasa de bits, y un archivo convertido a una tasa mayor conserva el corte del original. Es una estimación, no un veredicto: algunas grabaciones no tienen agudos por sí mismas. Conviene escuchar los archivos sospechosos antes de sustituirlos." />
        </StackPanel>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding OcupadaSinAvance}" Height="4" Margin="0,0,0,6" />
        <ProgressBar DockPanel.Dock="Top" Minimum="0" Maximum="100" Value="{Binding Progress}" Height="8"
                     IsVisible="{Binding AnalizandoEspectro}" Margin="0,0,0,6" />

        <DataGrid Name="Grid" ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}"
                  x:CompileBindings="False" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                  PointerPressed="Grid_PointerPressed" DoubleTapped="Grid_DoubleTapped">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Abrir carpeta contenedora" Command="{Binding OpenContainingFolderCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Archivo" Binding="{Binding FileName}" Width="2*" MinWidth="150" />
                <DataGridTextColumn Header="Calidad" Binding="{Binding QualityLabel}" Width="100" MinWidth="80" />
                <DataGridTextColumn Header="Bitrate" Binding="{Binding Bitrate}" Width="80" MinWidth="60" />
                <!-- Se ordena por la frecuencia, no por el texto: «9,8 kHz» no puede ir detrás de «16,0 kHz». -->
                <DataGridTextColumn Header="Corte medido" Binding="{Binding CorteMedido}" SortMemberPath="CorteOrden" Width="110" MinWidth="90" />
                <DataGridTextColumn Header="Calidad real (estimada)" Binding="{Binding CalidadReal}" Width="200" MinWidth="140" />
                <DataGridTextColumn Header="Muestreo" Binding="{Binding SampleRate}" Width="90" MinWidth="70" />
                <DataGridTextColumn Header="Canales" Binding="{Binding Channels}" Width="70" MinWidth="60" />
                <DataGridTextColumn Header="Dur." Binding="{Binding Duration}" Width="70" MinWidth="55" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
