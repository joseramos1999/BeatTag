<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Etiquetador.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="640"
             x:Class="Etiquetador.App.Views.ColeccionesView"
             x:DataType="vm:ColeccionesViewModel">

    <Grid ColumnDefinitions="200,4,300,4,*" RowDefinitions="Auto,*" Margin="8">

        <StackPanel Grid.Row="0" Grid.ColumnSpan="5" Spacing="2" Margin="0,0,0,8">
            <TextBlock Classes="titulo" Text="Colecciones inteligentes" />
            <TextBlock Classes="desc"
                       Text="Listas que se rellenan solas a partir de unas condiciones, como «house vocal, energía 6 a 7, para apertura». Se mantienen al día cuando entra música nueva o se completa una ficha, y se pueden guardar como M3U8 para rekordbox, Serato o Engine DJ." />
        </StackPanel>

        <!-- Colecciones guardadas -->
        <DockPanel Grid.Row="1" Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                <Button Content="Nueva" Command="{Binding NuevaCommand}" Background="#2563EB" Foreground="White" FontWeight="SemiBold" />
                <Button Content="Duplicar" Command="{Binding DuplicarCommand}" IsEnabled="{Binding HaySeleccionada}" />
            </StackPanel>
            <Button DockPanel.Dock="Bottom" Content="Eliminar colección" Click="Eliminar_Click"
                    IsEnabled="{Binding HaySeleccionada}" HorizontalAlignment="Stretch" Margin="0,6,0,0" />
            <ListBox ItemsSource="{Binding Colecciones}" SelectedItem="{Binding Seleccionada}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:ColeccionItem">
                        <TextBlock Text="{Binding Nombre}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="4" Background="#33888888" ResizeDirection="Columns" />

        <!-- Condiciones -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" Margin="8,0,6,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="6" IsEnabled="{Binding HaySeleccionada}" Margin="0,0,6,0">
                <TextBlock Text="Nombre" />
                <TextBox Text="{Binding Nombre}" />

                <TextBlock Text="Artista, título o archivo" Margin="0,6,0,0" />
                <TextBox Text="{Binding Texto}" PlaceholderText="Palabras sueltas, en cualquier orden" />

                <TextBlock Text="Género contiene" />
                <TextBox Text="{Binding Genero}" PlaceholderText="house, reggaeton…"
                         ToolTip.Tip="Varios géneros separados por comas: basta con que coincida uno." />

                <TextBlock Text="BPM" />
                <Grid ColumnDefinitions="*,8,*">
                    <NumericUpDown Grid.Column="0" Value="{Binding BpmMin}" Minimum="0" Maximum="300" Increment="1"
                                   FormatString="0" PlaceholderText="Desde" />
                    <NumericUpDown Grid.Column="2" Value="{Binding BpmMax}" Minimum="0" Maximum="300" Increment="1"
                                   FormatString="0" PlaceholderText="Hasta" />
                </Grid>

                <TextBlock Text="Año" />
                <Grid ColumnDefinitions="*,8,*">
                    <NumericUpDown Grid.Column="0" Value="{Binding AnioMin}" Minimum="0" Maximum="2100" Increment="1"
                                   FormatString="0" PlaceholderText="Desde" />
                    <NumericUpDown Grid.Column="2" Value="{Binding AnioMax}" Minimum="0" Maximum="2100" Increment="1"
                                   FormatString="0" PlaceholderText="Hasta" />
                </Grid>

                <TextBlock Text="Energía" />
                <Grid ColumnDefinitions="*,8,*">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding OpcionesEnergia}" SelectedItem="{Binding EnergiaMin}"
                              HorizontalAlignment="Stretch" ToolTip.Tip="Desde" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding OpcionesEnergia}" SelectedItem="{Binding EnergiaMax}"
                              HorizontalAlignment="Stretch" ToolTip.Tip="Hasta" />
                </Grid>

                <TextBlock Text="Momento de la sesión (cualquiera de los marcados)" TextWrapping="Wrap" />
                <WrapPanel>
                    <CheckBox Content="Apertura" IsChecked="{Binding Apertura}" Margin="0,0,10,0" />
                    <CheckBox Content="Subida" IsChecked="{Binding Subida}" Margin="0,0,10,0" />
                    <CheckBox Content="Pico" IsChecked="{Binding Pico}" Margin="0,0,10,0" />
                    <CheckBox Content="Cierre" IsChecked="{Binding Cierre}" Margin="0,0,10,0" />
                    <CheckBox Content="After" IsChecked="{Binding After}" Margin="0,0,10,0" />
                </WrapPanel>

                <Grid ColumnDefinitions="*,8,*">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="Voz" />
                        <ComboBox ItemsSource="{Binding OpcionesVoz}" SelectedItem="{Binding Voz}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Text="Letra" />
                        <ComboBox ItemsSource="{Binding OpcionesLetra}" SelectedItem="{Binding Letra}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Idioma" />
                <TextBox Text="{Binding Idioma}" PlaceholderText="ES, EN…" />

                <TextBlock Text="Ambiente (todos los indicados)" />
                <TextBox Text="{Binding Ambiente}" PlaceholderText="Separados por comas" />

                <TextBlock Text="Etiquetas (todas las indicadas)" />
                <TextBox Text="{Binding Etiquetas}" PlaceholderText="Separadas por comas" />

                <CheckBox Content="Solo armas secretas" IsChecked="{Binding SoloArmasSecretas}" />

                <TextBlock Text="{Binding EtiquetasEnUso}" Classes="desc" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Row="1" Grid.Column="3" Width="4" Background="#33888888" ResizeDirection="Columns" />

        <!-- Resultado -->
        <DockPanel Grid.Row="1" Grid.Column="4" Margin="8,0,0,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                <TextBlock Text="{Binding Resumen}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="Guardar como lista (M3U8)" Click="ExportM3u_Click"
                        Background="#0D9488" Foreground="White" FontWeight="SemiBold"
                        ToolTip.Tip="Guarda la colección como lista M3U8, en el orden de la tabla. No copia ni mueve archivos." />
            </StackPanel>
            <DataGrid ItemsSource="{Binding ResultadosView}" SelectedItem="{Binding SelectedRow}"
                      x:CompileBindings="False" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                      PointerPressed="Grid_PointerPressed" DoubleTapped="Grid_DoubleTapped">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Escuchar / Parar" Command="{Binding PlayPreviewCommand}" />
                        <MenuItem Header="Abrir carpeta contenedora" Command="{Binding OpenContainingFolderCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Artista" Binding="{Binding Artist}" Width="1.2*" MinWidth="90" />
                    <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="1.5*" MinWidth="100" />
                    <DataGridTextColumn Header="BPM" Binding="{Binding BpmTexto}" SortMemberPath="Bpm" Width="70" MinWidth="66" />
                    <DataGridTextColumn Header="Tono" Binding="{Binding Camelot}" Width="64" MinWidth="60" />
                    <DataGridTextColumn Header="Energía" Binding="{Binding Energia}" SortMemberPath="EnergiaValor" Width="92" MinWidth="88" />
                    <DataGridTextColumn Header="Momento" Binding="{Binding Momentos}" Width="110" MinWidth="70" />
                    <DataGridTextColumn Header="Género" Binding="{Binding Genre}" Width="90" MinWidth="60" />
                    <DataGridTextColumn Header="Dur." Binding="{Binding Duracion}" Width="62" MinWidth="58" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
