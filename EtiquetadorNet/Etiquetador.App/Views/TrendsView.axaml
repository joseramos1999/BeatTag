<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Etiquetador.App.ViewModels"
             xmlns:views="using:Etiquetador.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="560"
             x:Class="Etiquetador.App.Views.TrendsView"
             x:CompileBindings="False">

    <DockPanel Margin="8">

        <StackPanel DockPanel.Dock="Top" Spacing="6">
            <TextBlock Classes="titulo" Text="Listas de éxitos por país" />
            <TextBlock Classes="desc"
                       Text="Qué se está escuchando ahora mismo en cada país. Se marca lo que ya tienes en la biblioteca, de modo que se ve de un vistazo lo que te falta." />

            <!-- Qué lista: fuente, país y tamaño. Con una ventana estrecha los botones pasan a la línea siguiente. -->
            <WrapPanel ItemSpacing="8" LineSpacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Fuente" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Fuentes}" SelectedItem="{Binding Fuente}"
                              MinWidth="220" IsEnabled="{Binding !IsBusy}"
                              ToolTip.Tip="Spotify es el chart que se corresponde con lo que suena de verdad. Deezer queda como alternativa: es pública y sin clave, pero su reparto de oyentes no es el del mercado." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="País" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Countries}" SelectedItem="{Binding SelectedCountry}"
                              MinWidth="200" IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Lista" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding ListSizes}" SelectedItem="{Binding ListSize}"
                              MinWidth="80" IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
                <Button Content="Ver tendencias" Command="{Binding LoadCommand}" IsEnabled="{Binding !IsBusy}"
                        Background="#7C3AED" Foreground="White" FontWeight="SemiBold" />
                <Button Content="Actualizar" Command="{Binding ActualizarCommand}" IsEnabled="{Binding !IsBusy}"
                        ToolTip.Tip="Vuelve a descargar la lista aunque la guardada sea reciente. Las listas se guardan unas horas para no pedirlas en cada consulta." />
                <Button Content="Cancelar" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" />
                <Button Content="{Binding TextoSeguir}" Command="{Binding SeguirListaCommand}" IsEnabled="{Binding !IsBusy}"
                        ToolTip.Tip="Guarda lo que tiene hoy este chart (con su país y su tamaño). A partir de mañana, al volver a verlo o con «Actualizar todas» en Pendientes, se marcan las canciones que hayan entrado." />
            </WrapPanel>

            <!-- Qué hacer con ella. -->
            <WrapPanel ItemSpacing="8" LineSpacing="6">
                <CheckBox Content="Mostrar solo las disponibles" IsChecked="{Binding SoloLasQueTengo}" VerticalAlignment="Center" />
                <CheckBox Content="Solo nuevas" IsChecked="{Binding SoloNuevas}" VerticalAlignment="Center" IsEnabled="{Binding EstaSeguida}"
                          ToolTip.Tip="Solo las canciones que han entrado desde la última vez que se revisó el chart en un día anterior. Hace falta seguirlo." />
                <Button Content="Guardar como lista (M3U8)" Click="ExportM3u_Click"
                        Background="#0D9488" Foreground="White" FontWeight="SemiBold"
                        ToolTip.Tip="Guarda las canciones que ya tienes como una lista M3U8, en el orden del top. Se abre directamente en rekordbox, Engine DJ o Serato, sin copiar archivos." />
                <Button Content="Crear carpeta con las disponibles" Click="CreateFolder_Click"
                        IsEnabled="{Binding !IsBusy}"
                        Background="#16A34A" Foreground="White" FontWeight="SemiBold"
                        ToolTip.Tip="Copia (no mueve) a una carpeta nueva las grabaciones de la lista que ya están en la biblioteca, numeradas por su posición." />
                <Button Content="Ordenar para mezclar" Command="{Binding OrdenarParaMezclarCommand}" IsEnabled="{Binding !IsBusy}"
                        Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                        ToolTip.Tip="Ordena las canciones que tienes para pincharlas seguidas: tonos compatibles en la rueda Camelot, tempo (contando doble y mitad) y, si tienen ficha de DJ, energía que no baja. Usa el BPM y la tonalidad de las etiquetas." />
                <Button Content="Añadir a pendientes ▾" IsEnabled="{Binding !IsBusy}"
                        ToolTip.Tip="Guarda en la lista de Pendientes las canciones que te faltan. Se tachan solas cuando aparecen en la biblioteca.">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Las seleccionadas que faltan" Click="AnadirSeleccionadas_Click" />
                            <MenuItem Header="Todas las que faltan" Click="AnadirTodas_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </WrapPanel>

            <!-- De cuándo es la lista: sin conexión se enseña la última guardada, y hay que saberlo. -->
            <TextBlock Classes="desc" Text="{Binding FechaLista}" />
            <!-- Si se sigue: qué ha entrado desde la última revisión. -->
            <TextBlock Classes="desc" Text="{Binding Novedades}"
                       IsVisible="{Binding Novedades, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        </StackPanel>

        <Grid>
            <DataGrid Name="RowsGrid" ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False" IsReadOnly="True" IsVisible="{Binding !VerOrdenMezcla}"
                      CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                      DoubleTapped="Grid_DoubleTapped" PointerPressed="Grid_PointerPressed">
                <DataGrid.Styles>
                    <Style Selector="DataGridRow">
                        <Setter Property="Background" Value="{Binding StateBrush}" />
                    </Style>
                </DataGrid.Styles>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <!-- El orden común de las tablas con canciones: ver AccionesCancion.Puesto. -->
                        <MenuItem Header="Escuchar / Parar" Command="{Binding PlayPreviewCommand}" />
                        <MenuItem Header="Editar etiquetas de esta canción" Command="{x:Static AccionesCancion.EditarEtiquetas}" CommandParameter="{Binding SelectedRow}" />
                        <Separator />
                        <MenuItem Header="Buscar compatibles…" Command="{x:Static AccionesCancion.BuscarCompatibles}" CommandParameter="{Binding SelectedRow}" />
                        <MenuItem Header="Ver sus versiones…" Command="{x:Static AccionesCancion.VerVersiones}" CommandParameter="{Binding SelectedRow}" />
                        <Separator />
                        <MenuItem Header="Abrir carpeta contenedora" Command="{Binding OpenContainingFolderCommand}" />
                        <Separator />
                        <MenuItem Header="Añadir a pendientes" Click="AnadirSeleccionadas_Click" />
                        <MenuItem Header="Buscar en mi pool" Command="{Binding BuscarEnPoolCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="45" MinWidth="40" />
                    <DataGridTextColumn Header="Artista" Binding="{Binding Artist}" Width="180" MinWidth="100" />
                    <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="220" MinWidth="120" />
                    <DataGridTextColumn Header="Dur." Binding="{Binding DurText}" Width="60" MinWidth="50" />
                    <DataGridTextColumn Header="Disponibilidad" Binding="{Binding Estado}" Width="110" MinWidth="90" />
                    <DataGridTextColumn Header="Novedad" Binding="{Binding Novedad}" Width="130" MinWidth="80" />
                    <DataGridTextColumn Header="Versión" Binding="{Binding Version}" Width="120" MinWidth="90" />
                    <DataGridTextColumn Header="Archivo en la biblioteca" Binding="{Binding FileName}" Width="*" MinWidth="140" />
                </DataGrid.Columns>
            </DataGrid>

            <views:OrdenMezclaPanel IsVisible="{Binding VerOrdenMezcla}" />
        </Grid>
    </DockPanel>
</UserControl>
