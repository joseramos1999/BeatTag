<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Etiquetador.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="560"
             x:Class="Etiquetador.App.Views.TrendsView"
             x:CompileBindings="False">

    <DockPanel Margin="8">

        <StackPanel DockPanel.Dock="Top" Spacing="6">
            <TextBlock Text="Listas de éxitos por país" FontWeight="Bold" FontSize="15" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="País" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Countries}" SelectedItem="{Binding SelectedCountry}"
                          MinWidth="200" IsEnabled="{Binding !IsBusy}" />
                <TextBlock Text="Lista" VerticalAlignment="Center" Margin="8,0,0,0" />
                <ComboBox ItemsSource="{Binding ListSizes}" SelectedItem="{Binding ListSize}"
                          MinWidth="80" IsEnabled="{Binding !IsBusy}" />
                <Button Content="Ver tendencias" Command="{Binding LoadCommand}" IsEnabled="{Binding !IsBusy}"
                        Background="#7C3AED" Foreground="White" FontWeight="SemiBold" />
                <Button Content="Cancelar" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" />
                <CheckBox Content="Mostrar solo las disponibles" IsChecked="{Binding SoloLasQueTengo}" VerticalAlignment="Center" />
                <Button Content="Crear carpeta con las disponibles" Click="CreateFolder_Click"
                        IsEnabled="{Binding !IsBusy}"
                        Background="#16A34A" Foreground="White" FontWeight="SemiBold"
                        ToolTip.Tip="Copia (no mueve) a una carpeta nueva las grabaciones de la lista que ya están en la biblioteca, numeradas por su posición." />
            </StackPanel>

            <TextBlock Text="{Binding Status}" Foreground="Gray" TextTrimming="CharacterEllipsis" Margin="0,2,0,4" />
        </StackPanel>

        <DataGrid Name="RowsGrid" ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                  DoubleTapped="Grid_DoubleTapped" PointerPressed="Grid_PointerPressed">
            <DataGrid.Styles>
                <Style Selector="DataGridRow">
                    <Setter Property="Background" Value="{Binding StateBrush}" />
                </Style>
            </DataGrid.Styles>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Escuchar / Parar" Command="{Binding PlayPreviewCommand}" />
                    <MenuItem Header="Abrir carpeta contenedora" Command="{Binding OpenContainingFolderCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="45" MinWidth="40" />
                <DataGridTextColumn Header="Artista" Binding="{Binding Artist}" Width="180" MinWidth="100" />
                <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="220" MinWidth="120" />
                <DataGridTextColumn Header="Dur." Binding="{Binding DurText}" Width="60" MinWidth="50" />
                <DataGridTextColumn Header="Disponibilidad" Binding="{Binding Estado}" Width="110" MinWidth="90" />
                <DataGridTextColumn Header="Archivo en la biblioteca" Binding="{Binding FileName}" Width="*" MinWidth="140" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
