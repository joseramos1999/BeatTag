<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Etiquetador.App.ViewModels"
             xmlns:views="using:Etiquetador.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="640"
             x:Class="Etiquetador.App.Views.AsistenteView"
             x:DataType="vm:AsistenteViewModel">

    <DockPanel Margin="8">

        <!-- Cancelar va junto al título y no en la banda de la IA: sirve para cualquier herramienta
             (también las de solo reglas y el envío a la papelera), no solo para las que usan la IA. -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Classes="titulo" Text="Asistente IA" />
                <TextBlock Classes="desc"
                           Text="Herramientas para revisar y ordenar tu biblioteca. Unas funcionan solo con reglas y otras usan además la IA local de tu equipo, sin enviar nada a internet; la descripción de cada una lo indica. En todas, lo que se propone lo decides tú: nada se guarda ni se escribe en tus archivos sin que lo revises y lo aceptes." />
            </StackPanel>
            <Button Grid.Column="1" Content="Cancelar el proceso" Command="{Binding CancelarCommand}" IsVisible="{Binding IsBusy}"
                    VerticalAlignment="Top" Margin="12,0,0,0"
                    ToolTip.Tip="Detiene la herramienta que está trabajando. Lo que ya se ha escrito o enviado a la papelera se queda así." />
        </Grid>

        <!-- Estado de la IA: solo afecta a las herramientas que la usan -->
        <Border DockPanel.Dock="Top" Padding="10,6" CornerRadius="6" Margin="0,0,0,8"
                Background="{DynamicResource SuperficieSuave}" BorderBrush="{DynamicResource BordeSuave}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="🤖" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding EstadoIa}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" Content="Comprobar la IA" Command="{Binding ComprobarIaCommand}" IsEnabled="{Binding !IsBusy}" Margin="8,0,0,0" />
            </Grid>
        </Border>

        <TabControl>

            <!-- ============================ 1. BUSCAR CON UNA FRASE ============================ -->
            <TabItem Header="Buscar con una frase">
                <Grid RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="*,4,*" DataContext="{Binding Busqueda}" x:DataType="vm:BusquedaFraseViewModel" Margin="0,8,0,0">
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Classes="desc" Margin="0,0,0,6"
                               Text="Describe lo que buscas como se lo dirías a otro DJ. Lo que se puede leer sin interpretar (géneros y artistas que tienes, BPM, décadas, «sin palabrotas», el momento de la sesión) se detecta con reglas; la IA añade el resto, y solo si lo justifica con tus palabras. Revisa las condiciones y crea la colección." />
                    <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                        <TextBox Grid.Column="0" Text="{Binding Frase}" PlaceholderText="Por ejemplo: bachata romántica de los 2000 para cerrar" />
                        <Button Grid.Column="1" Content="Interpretar" Command="{Binding InterpretarCommand}" Margin="6,0,0,0"
                                IsEnabled="{Binding !$parent[UserControl].((vm:AsistenteViewModel)DataContext).IsBusy}"
                                Background="#2563EB" Foreground="White" FontWeight="SemiBold" IsDefault="True" />
                    </Grid>
                    <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,8">
                        <TextBlock Text="Ejemplos:" VerticalAlignment="Center" Margin="0,0,6,4" Foreground="{DynamicResource TextoSecundario}" />
                        <ItemsControl ItemsSource="{Binding Ejemplos}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Content="{Binding}" Margin="0,0,6,4" FontSize="12"
                                            Command="{Binding $parent[ItemsControl].((vm:BusquedaFraseViewModel)DataContext).UsarEjemploCommand}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                    <!-- Condiciones -->
                    <DockPanel Grid.Row="3" Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Condiciones" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding HayFiltros}">
                            <TextBlock Text="Nombre de la colección" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding NombreColeccion}" />
                                <Button Grid.Column="1" Content="Crear colección" Command="{Binding CrearColeccionCommand}" Margin="6,0,0,0"
                                        Background="#16A34A" Foreground="White" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Filtros}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:FiltroFila">
                                    <Grid ColumnDefinitions="Auto,*" Opacity="{Binding SePuedeUsar, Converter={x:Static views:AsistenteView.Atenuar}}">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding Aceptado}" IsEnabled="{Binding SePuedeUsar}" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding Campo}" FontWeight="SemiBold" />
                                                <Run Text=": " />
                                                <Run Text="{Binding Valor}" />
                                                <Run Text="  " />
                                                <Run Text="{Binding Cita}" Foreground="{DynamicResource TextoSecundario}" />
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextoSecundario}" TextWrapping="Wrap">
                                                <Run Text="{Binding Origen}" />
                                                <Run Text="{Binding Motivo}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Vista previa -->
                    <DockPanel Grid.Row="3" Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Resumen}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <Border DockPanel.Dock="Top" Padding="8,6" CornerRadius="4" Margin="0,0,0,6"
                                Background="{DynamicResource AvisoFondo}" BorderBrush="{DynamicResource AvisoBorde}" BorderThickness="1"
                                IsVisible="{Binding Aviso, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding Aviso}" Foreground="{DynamicResource AvisoTexto}" TextWrapping="Wrap" />
                        </Border>
                        <DataGrid Name="TablaBusqueda" ItemsSource="{Binding Vista}" x:CompileBindings="False" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Artista" Binding="{Binding Artist}" Width="*" />
                                <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="*" />
                                <DataGridTextColumn Header="Género" Binding="{Binding Genre}" Width="90" />
                                <DataGridTextColumn Header="BPM" Binding="{Binding BpmTexto}" SortMemberPath="Bpm" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============================ 2. PROPONER FICHAS ============================ -->
            <TabItem Header="Proponer fichas">
                <DockPanel DataContext="{Binding FichasIa}" x:DataType="vm:FichasIaViewModel" Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" Classes="desc" Margin="0,0,0,6"
                               Text="Propone el idioma y si lleva voz para las canciones que no los tienen en su ficha. Solo esos dos datos: medida con canciones conocidas, la IA acierta el idioma en unas 7 de cada 10 canciones (suele fallar cuando deduce por la nacionalidad del artista) y no sabe estimar la energía. Nunca cambia lo que ya hayas rellenado. Lo que propone la IA sale desmarcado: revisa, marca lo correcto y acepta. Cada aceptación se puede deshacer, y cada nueva búsqueda continúa con canciones que aún no se han revisado." />
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Canciones de" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <ComboBox ItemsSource="{Binding Ambitos}" SelectedItem="{Binding Ambito}" MinWidth="200" Margin="0,0,12,4" />
                        <TextBlock Text="Como máximo" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <ComboBox ItemsSource="{Binding Limites}" SelectedItem="{Binding Limite}" MinWidth="90" Margin="0,0,12,4" />
                        <Button Content="Proponer" Command="{Binding ProponerCommand}" Margin="0,0,6,4"
                                IsEnabled="{Binding !$parent[UserControl].((vm:AsistenteViewModel)DataContext).IsBusy}"
                                Background="#2563EB" Foreground="White" FontWeight="SemiBold" />
                        <Button Content="Empezar desde el principio" Command="{Binding EmpezarDeNuevoCommand}" Margin="0,0,12,4"
                                IsEnabled="{Binding !$parent[UserControl].((vm:AsistenteViewModel)DataContext).IsBusy}"
                                ToolTip.Tip="Cada búsqueda salta las canciones ya revisadas en esta sesión y no aceptadas. Esto las vuelve a incluir." />
                        <Button Content="Marcar todas" Command="{Binding MarcarTodasCommand}" Margin="0,0,6,4" />
                        <Button Content="Desmarcar todas" Command="{Binding MarcarNingunaCommand}" Margin="0,0,12,4" />
                        <Button Content="Aceptar las marcadas" Command="{Binding AceptarCommand}" Margin="0,0,6,4"
                                IsEnabled="{Binding !$parent[UserControl].((vm:AsistenteViewModel)DataContext).IsBusy}"
                                Background="#16A34A" Foreground="White" FontWeight="SemiBold" />
                        <Button Content="Deshacer la última aceptación" Command="{Binding DeshacerAceptacionCommand}" Margin="0,0,12,4"
                                IsEnabled="{Binding HayAceptacionQueDeshacer}"
                                ToolTip.Tip="Devuelve el idioma y la voz que tenían las fichas antes de la última aceptación, y vuelve a poner esas propuestas en la lista." />
                        <TextBlock Text="{Binding Resumen}" VerticalAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource TextoSecundario}" />
                    </WrapPanel>
                    <DataGrid Name="TablaFichas" ItemsSource="{Binding Propuestas}" x:CompileBindings="False" AutoGenerateColumns="False"
                              CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Aceptar" Binding="{Binding Aceptar}" Width="80" />
                            <DataGridTextColumn Header="Artista" Binding="{Binding Artist}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Idioma" Binding="{Binding Idioma}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="Voz" Binding="{Binding Voz}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="Origen" Binding="{Binding Origen}" Width="140" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================ 3. UNIFICAR GÉNEROS ============================ -->
            <TabItem Header="Unificar géneros">
                <DockPanel DataContext="{Binding Generos}" x:DataType="vm:GenerosIaViewModel" Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" Classes="desc" Margin="0,0,0,6"
                               Text="Agrupa las distintas formas de escribir un mismo género. Primero se aplican reglas (grafías conocidas y valores que no son un género, como un usuario de redes); la IA solo puede elegir entre los géneros que ya usas, nunca inventar uno ni vaciarlo. Lo propuesto por reglas sale marcado y lo de la IA desmarcado. Puedes corregir la propuesta escribiendo en la columna. Se puede deshacer desde Enriquecer." />
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button Content="Analizar géneros" Command="{Binding AnalizarCommand}" Margin="0,0,12,4"
                                IsEnabled="{Binding !$parent[UserControl].((vm:AsistenteViewModel)DataContext).IsBusy}"
                                Background="#2563EB" Foreground="White" FontWeight="SemiBold" />
                        <Button Content="Marcar todas" Command="{Binding MarcarTodasCommand}" Margin="0,0,6,4" />
                        <Button Content="Desmarcar todas" Command="{Binding MarcarNingunaCommand}" Margin="0,0,12,4" />
                        <Button Content="Aplicar las marcadas" Click="AplicarGeneros_Click" Margin="0,0,12,4"
                                IsEnabled="{Binding !$parent[UserControl].((vm:AsistenteViewModel)DataContext).IsBusy}"
                                Background="#16A34A" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Resumen}" VerticalAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource TextoSecundario}" />
                    </WrapPanel>
                    <DataGrid Name="TablaGeneros" ItemsSource="{Binding Filas}" x:CompileBindings="False" AutoGenerateColumns="False"
                              CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Aplicar" Binding="{Binding Aplicar}" Width="80" />
                            <DataGridTextColumn Header="Género actual" Binding="{Binding Original}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Canciones" Binding="{Binding Canciones}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="Quedaría como" Binding="{Binding Propuesto}" Width="*" />
                            <DataGridTextColumn Header="Origen" Binding="{Binding Origen}" Width="140" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================ 5. RENOMBRAR CON IA ============================ -->
            <TabItem Header="Renombrar con IA">
                <DockPanel DataContext="{Binding Renombrar}" x:DataType="vm:RenombrarIaViewModel" Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" Classes="desc" Margin="0,0,0,6"
                               Text="Propone un nombre limpio («Artista - Título (Versión)») para los archivos con nombre sucio: BPM, tonalidad, record pools, guiones bajos, nombres cortados o sin separar artista y título. Los nombres ya limpios y los mashups no se tocan. La IA solo puede reordenar lo que ya dice el nombre o las etiquetas, nunca inventar, y cada propuesta pasa por comprobaciones; lo que no se puede comprobar se avisa. Medido sobre bibliotecas reales, unas 3 de cada 4 propuestas son buenas: todo sale desmarcado y puedes corregir el nombre antes de aceptarlo." />
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Canciones de" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <ComboBox ItemsSource="{Binding Ambitos}" SelectedItem="{Binding Ambito}" MinWidth="200" Margin="0,0,12,4" />
                        <TextBlock Text="Como máximo" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <ComboBox ItemsSource="{Binding Limites}" SelectedItem="{Binding Limite}" MinWidth="90" Margin="0,0,12,4" />
                        <Button Content="Proponer nombres" Command="{Binding ProponerCommand}" Margin="0,0,6,4"
                                IsEnabled="{Binding !$parent[UserControl].((vm:AsistenteViewModel)DataContext).IsBusy}"
                                Background="#2563EB" Foreground="White" FontWeight="SemiBold" />
                        <Button Content="Empezar desde el principio" Command="{Binding EmpezarDeNuevoCommand}" Margin="0,0,12,4"
                                IsEnabled="{Binding !$parent[UserControl].((vm:AsistenteViewModel)DataContext).IsBusy}"
                                ToolTip.Tip="Cada búsqueda salta los nombres ya revisados en esta sesión y no renombrados. Esto los vuelve a incluir." />
                        <CheckBox Content="Solo las que no tienen avisos" IsChecked="{Binding SoloSinAvisos}" Margin="0,0,12,4" />
                        <Button Content="Marcar las visibles" Command="{Binding MarcarTodasCommand}" Margin="0,0,6,4" />
                        <Button Content="Desmarcar todas" Command="{Binding MarcarNingunaCommand}" Margin="0,0,12,4" />
                        <Button Content="Renombrar las marcadas" Click="Renombrar_Click" Margin="0,0,12,4"
                                IsEnabled="{Binding !$parent[UserControl].((vm:AsistenteViewModel)DataContext).IsBusy}"
                                Background="#16A34A" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Resumen}" VerticalAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource TextoSecundario}" />
                    </WrapPanel>
                    <DataGrid Name="TablaRenombrar" ItemsSource="{Binding FilasView}" x:CompileBindings="False" AutoGenerateColumns="False"
                              CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Aceptar" Binding="{Binding Aceptar}" Width="80" />
                            <DataGridTextColumn Header="Nombre actual" Binding="{Binding Actual}" Width="1.2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Nombre propuesto" Binding="{Binding Propuesto}" Width="1.2*" />
                            <DataGridTextColumn Header="Avisos" Binding="{Binding Avisos}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Carpeta" Binding="{Binding Carpeta}" Width="120" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================ 6. COMPLETAR NOMBRES CORTADOS ============================ -->
            <TabItem Header="Completar nombres cortados">
                <DockPanel DataContext="{Binding Completar}" x:DataType="vm:CompletarNombresViewModel" Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" Classes="desc" Margin="0,0,0,6"
                               Text="Los record pools y algunas descargas recortan el nombre a una longitud fija y lo dejan a medias: «… (F3LY Intro Hype Dur», «… UNA AMAPO». Aquí se localizan y se propone el nombre entero. Primero con las etiquetas del propio archivo, que en la mayoría de los casos ya lo traen completo: eso no lo inventa nadie y sale marcado. Para los que llegaron sin etiquetas se consulta a la IA, que solo puede alargar lo que ya está —no cambiar la canción por otra— y su propuesta se contrasta con Deezer; esas salen desmarcadas." />
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Canciones de" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <ComboBox ItemsSource="{Binding Ambitos}" SelectedItem="{Binding Ambito}" MinWidth="200" Margin="0,0,12,4" />
                        <TextBlock Text="Como máximo" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <ComboBox ItemsSource="{Binding Limites}" SelectedItem="{Binding Limite}" MinWidth="90" Margin="0,0,12,4" />
                        <CheckBox Content="Usar la IA para los que no tienen etiquetas" IsChecked="{Binding UsarIa}" Margin="0,0,12,4"
                                  ToolTip.Tip="Cuesta alrededor de medio segundo por canción. Sin esto solo se usan las etiquetas del propio archivo, que es lo más fiable y es instantáneo." />
                        <Button Content="Buscar cortados" Command="{Binding BuscarCommand}" Margin="0,0,12,4"
                                IsEnabled="{Binding !$parent[UserControl].((vm:AsistenteViewModel)DataContext).IsBusy}"
                                Background="#2563EB" Foreground="White" FontWeight="SemiBold" />
                        <Button Content="Marcar todas" Command="{Binding MarcarTodasCommand}" Margin="0,0,6,4" />
                        <Button Content="Desmarcar todas" Command="{Binding MarcarNingunaCommand}" Margin="0,0,12,4" />
                        <Button Content="Completar las marcadas" Click="Completar_Click" Margin="0,0,12,4"
                                IsEnabled="{Binding !$parent[UserControl].((vm:AsistenteViewModel)DataContext).IsBusy}"
                                Background="#16A34A" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Resumen}" VerticalAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource TextoSecundario}" />
                    </WrapPanel>
                    <DataGrid Name="TablaCompletar" ItemsSource="{Binding Filas}" x:CompileBindings="False" AutoGenerateColumns="False"
                              CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Aceptar" Binding="{Binding Aceptar}" Width="80" />
                            <DataGridTextColumn Header="Nombre cortado" Binding="{Binding Actual}" Width="1.2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Nombre completo" Binding="{Binding Propuesto}" Width="1.4*" />
                            <DataGridTextColumn Header="De dónde sale" Binding="{Binding Origen}" Width="200" IsReadOnly="True" />
                            <DataGridTextColumn Header="Detalle" Binding="{Binding Detalle}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================ 4. ORDENAR PARA MEZCLAR ============================ -->
            <TabItem Header="Ordenar para mezclar">
                <DockPanel DataContext="{Binding Mezcla}" x:DataType="vm:MezclaViewModel" Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" Classes="desc" Margin="0,0,0,6"
                               Text="Ordena una colección para pincharla seguida: empieza por lo más tranquilo y encadena cada canción con la que mejor entra, priorizando tonos compatibles en la rueda Camelot, después el tempo (contando doble y mitad) y, si las canciones tienen ficha, que se respete el momento de la sesión (Apertura, Subida, Pico, Cierre, After) y que la energía no baje. Con clic derecho sobre una canción puedes empezar por ella, buscar sus compatibles o ver sus versiones. No usa la IA: son reglas de mezcla y sale igual cada vez. Necesita la tonalidad en las etiquetas." />
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Colección" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <ComboBox ItemsSource="{Binding Colecciones}" SelectedItem="{Binding Coleccion}" MinWidth="220" Margin="0,0,12,4" />
                        <Button Content="Ordenar" Command="{Binding OrdenarCommand}" Margin="0,0,12,4"
                                IsEnabled="{Binding !$parent[UserControl].((vm:AsistenteViewModel)DataContext).IsBusy}"
                                Background="#2563EB" Foreground="White" FontWeight="SemiBold" />
                        <Button Content="Guardar como lista (M3U8)" Click="ExportarMezcla_Click" Margin="0,0,12,4"
                                Background="#0D9488" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Resumen}" VerticalAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource TextoSecundario}" TextWrapping="Wrap" />
                    </WrapPanel>
                    <DataGrid Name="TablaMezcla" ItemsSource="{Binding Pasos}" x:CompileBindings="False" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserResizeColumns="True" CanUserSortColumns="False" GridLinesVisibility="Horizontal"
                              Loaded="TablaMezcla_Loaded">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Posicion}" Width="50" />
                            <DataGridTextColumn Header="Artista" Binding="{Binding Artist}" Width="*" />
                            <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="BPM" Binding="{Binding Bpm}" Width="70" />
                            <DataGridTextColumn Header="Tono" Binding="{Binding Camelot}" Width="70" />
                            <DataGridTextColumn Header="Energía" Binding="{Binding Energia}" Width="90" />
                            <DataGridTextColumn Header="Entrada desde la anterior" Binding="{Binding Transicion}" Width="220" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Equipo «asistente», tanda 3: herramientas solo con reglas (P8 y P9) ===== -->

            <!-- ============================ LIMPIAR LA PUBLICIDAD DE LOS PACKS (P8) ============================ -->
            <TabItem Header="Limpiar publicidad de packs">
                <DockPanel DataContext="{Binding Packs}" x:DataType="vm:LimpiarPacksViewModel" Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" Classes="desc" Margin="0,0,0,6"
                               Text="Quita de las etiquetas el nombre del record pool o del usuario que distribuyó el archivo: un Álbum como «Latin Box 15 12 2025» o «@usuario» y un Artista como «@usuario_dj». rekordbox muestra y busca en esos campos, y BeatTag usa el artista para reconocer duplicados. Funciona solo con reglas, sin IA: el álbum se vacía, y el artista se sustituye por el que figura en el nombre del archivo, escrito como en el resto de tu biblioteca, solo cuando ese nombre deja claro cuál es el artista (si no, no se propone nada). Lo dudoso sale desmarcado, por ejemplo un álbum que lleva más texto que el nombre del pool o que parece una web; la columna «Por qué» explica cada caso. Lo que se quita puede guardarse en el comentario para conservar, por ejemplo, la fecha del pack. Se puede deshacer desde Enriquecer." />
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button Content="Buscar publicidad" Command="{Binding ProponerCommand}" Margin="0,0,12,4"
                                IsEnabled="{Binding !$parent[UserControl].((vm:AsistenteViewModel)DataContext).IsBusy}"
                                Background="#2563EB" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="Lo que se quita:" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <ComboBox ItemsSource="{Binding Destinos}" SelectedIndex="{Binding Destino}" MinWidth="210" Margin="0,0,12,4"
                                  ToolTip.Tip="Guardarlo en el comentario añade al final «[Pack: …]» o «[Editor: …]», sin tocar lo que el comentario ya tenía." />
                        <Button Content="Marcar todas" Command="{Binding MarcarTodasCommand}" Margin="0,0,6,4" />
                        <Button Content="Desmarcar todas" Command="{Binding MarcarNingunaCommand}" Margin="0,0,12,4" />
                        <Button Content="Aplicar las marcadas" Click="AplicarPacks_Click" Margin="0,0,12,4"
                                IsEnabled="{Binding !$parent[UserControl].((vm:AsistenteViewModel)DataContext).IsBusy}"
                                Background="#16A34A" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Resumen}" VerticalAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource TextoSecundario}" TextWrapping="Wrap" />
                    </WrapPanel>
                    <DataGrid Name="TablaPacks" ItemsSource="{Binding Filas}" x:CompileBindings="False" AutoGenerateColumns="False"
                              CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Aplicar" Binding="{Binding Aplicar}" Width="80" />
                            <DataGridTextColumn Header="Campo" Binding="{Binding Campo}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="Ahora" Binding="{Binding Actual}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Quedaría como" Binding="{Binding Nuevo}" Width="*" />
                            <DataGridTextColumn Header="Lo que se quita" Binding="{Binding LoQueSeQuita}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Por qué" Binding="{Binding PorQue}" Width="1.5*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Archivo" Binding="{Binding Archivo}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================ GÉNERO POR CARPETA Y POR ARTISTA (P9) ============================ -->
            <TabItem Header="Género por carpeta y artista">
                <Grid DataContext="{Binding GeneroReglas}" x:DataType="vm:GeneroPorReglasViewModel" Margin="0,8,0,0"
                      RowDefinitions="Auto,Auto,*,6,Auto,1.4*">
                    <TextBlock Grid.Row="0" Classes="desc" Margin="0,0,0,6"
                               Text="Pone género a las canciones que no tienen, sin IA y sin pisar nunca un género existente. Primera regla: el género que asignes a una carpeta, que vale también para sus subcarpetas (si dos reglas cubren la misma canción, manda la carpeta más concreta). La lista incluye las carpetas que agrupan otras, y sus cifras cuentan las subcarpetas. Deja sin regla las carpetas que mezclan estilos, y excluye de la regla de su carpeta madre las subcarpetas que no le correspondan. Segunda regla, para lo que no cubre ninguna carpeta: el género que llevan casi todas las canciones del mismo artista, solo si tiene al menos 3 con género y 7 de cada 10 llevan el mismo. Las de carpeta salen marcadas; las de artista, solo cuando son 5 o más y al menos 9 de cada 10 coinciden. Conviene pasar antes «Unificar géneros». Se puede deshacer desde Enriquecer." />
                    <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                        <Button Content="Proponer géneros" Command="{Binding ProponerCommand}" Margin="0,0,12,4"
                                IsEnabled="{Binding !$parent[UserControl].((vm:AsistenteViewModel)DataContext).IsBusy}"
                                Background="#2563EB" Foreground="White" FontWeight="SemiBold" />
                        <ComboBox Name="GeneroCarpeta" IsEditable="True" ItemsSource="{Binding GenerosDisponibles}" Text="{Binding GeneroElegido}"
                                  PlaceholderText="Elige o escribe un género" MinWidth="220" Margin="0,0,6,4" MaxDropDownHeight="360" />
                        <Button Content="Poner a las seleccionadas" Click="PonerReglaCarpeta_Click" Margin="0,0,6,4" IsEnabled="{Binding !$parent[UserControl].((vm:AsistenteViewModel)DataContext).IsBusy}"
                                ToolTip.Tip="Asigna el género a las carpetas seleccionadas en la lista. Puedes seleccionar varias con Ctrl o Mayús." />
                        <Button Content="Quitar la regla" Click="QuitarReglaCarpeta_Click" Margin="0,0,6,4" IsEnabled="{Binding !$parent[UserControl].((vm:AsistenteViewModel)DataContext).IsBusy}"
                                ToolTip.Tip="Quita el género asignado a las carpetas seleccionadas o hace que dejen de estar excluidas. Vuelve a valer el de su carpeta madre, si lo tiene." />
                        <Button Content="Excluir de la regla de su carpeta madre" Click="ExcluirReglaCarpeta_Click" Margin="0,0,12,4" IsEnabled="{Binding !$parent[UserControl].((vm:AsistenteViewModel)DataContext).IsBusy}"
                                ToolTip.Tip="Para una subcarpeta que mezcla estilos (por ejemplo, «WarmUp» dentro de «Reggaeton»): no recibe el género de su carpeta madre, y sus canciones solo dependen del artista." />
                        <Button Content="Añadir otra carpeta…" Click="AnadirCarpetaGenero_Click" Margin="0,0,12,4" IsEnabled="{Binding !$parent[UserControl].((vm:AsistenteViewModel)DataContext).IsBusy}"
                                ToolTip.Tip="Para dar una regla a una carpeta que agrupa otras: vale para todas sus subcarpetas que no tengan regla propia." />
                        <TextBlock Text="{Binding ResumenCarpetas}" VerticalAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource TextoSecundario}" />
                    </WrapPanel>
                    <DataGrid Grid.Row="2" Name="TablaCarpetasGenero" ItemsSource="{Binding Carpetas}" x:CompileBindings="False" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Extended" SelectionChanged="CarpetasGenero_SelectionChanged"
                              CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Carpeta" Binding="{Binding Nombre}" Width="1.2*" />
                            <DataGridTextColumn Header="Sin género" Binding="{Binding SinGenero}" Width="100" />
                            <DataGridTextColumn Header="Canciones" Binding="{Binding Canciones}" Width="100" />
                            <DataGridTextColumn Header="Lo que llevan las que tienen género" Binding="{Binding Pista}" Width="*" />
                            <DataGridTextColumn Header="Género asignado" Binding="{Binding Regla}" Width="160" />
                            <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="3" ResizeDirection="Rows" Background="Transparent" />
                    <WrapPanel Grid.Row="4" Margin="0,4,0,6">
                        <Button Content="Marcar todas" Command="{Binding MarcarTodasCommand}" Margin="0,0,6,4" />
                        <Button Content="Desmarcar todas" Command="{Binding MarcarNingunaCommand}" Margin="0,0,12,4" />
                        <Button Content="Aplicar las marcadas" Click="AplicarGeneroReglas_Click" Margin="0,0,12,4"
                                IsEnabled="{Binding !$parent[UserControl].((vm:AsistenteViewModel)DataContext).IsBusy}"
                                Background="#16A34A" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Resumen}" VerticalAlignment="Center" Margin="0,0,12,4" Foreground="{DynamicResource TextoSecundario}" TextWrapping="Wrap" />
                        <TextBlock Text="Has cambiado reglas: vuelve a pulsar «Proponer géneros» para verlas aplicadas." IsVisible="{Binding ReglasSinAplicar}"
                                   VerticalAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource AvisoTexto}" TextWrapping="Wrap" />
                    </WrapPanel>
                    <DataGrid Grid.Row="5" Name="TablaGeneroReglas" ItemsSource="{Binding Propuestas}" x:CompileBindings="False" AutoGenerateColumns="False"
                              CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Aplicar" Binding="{Binding Aplicar}" Width="80" />
                            <DataGridTextColumn Header="Artista" Binding="{Binding Artist}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Género" Binding="{Binding Genero}" Width="140" />
                            <DataGridTextColumn Header="Regla" Binding="{Binding Regla}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="Por qué" Binding="{Binding PorQue}" Width="1.3*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Carpeta" Binding="{Binding Carpeta}" Width="140" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
