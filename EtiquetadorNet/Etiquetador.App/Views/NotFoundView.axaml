<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Etiquetador.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="560"
             x:Class="Etiquetador.App.Views.NotFoundView"
             x:DataType="vm:NotFoundViewModel">

    <DockPanel Margin="8">

        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
            <TextBlock Classes="titulo" Text="No encontradas" />
            <TextBlock Classes="desc"
                       Text="Canciones que ningún catálogo ha sabido identificar, normalmente por llevar el nombre muy alterado. Desde aquí puedes indicar a mano qué debe buscarse y elegir entre las coincidencias. Cuando la IA local ha entendido el nombre pero no hay catálogo que lo confirme, su propuesta aparece en «Sugerencia de la IA»: revísala y acéptala si es correcta." />
        </StackPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button Content="Analizar" Command="{Binding AnalyzeCommand}" IsEnabled="{Binding !IsBusy}"
                    Background="#2563EB" Foreground="White" FontWeight="SemiBold" Margin="0,0,6,4"
                    ToolTip.Tip="Rápido: usa la caché de análisis." />
            <Button Content="Reanalizar todo" Command="{Binding ReanalyzeAllCommand}" IsEnabled="{Binding !IsBusy}"
                    Background="#7C3AED" Foreground="White" FontWeight="SemiBold" Margin="0,0,6,4"
                    ToolTip.Tip="Ignora la caché y vuelve a analizar todo." />
            <Button Content="Cancelar" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}"
                    Background="#DC2626" Foreground="White" FontWeight="SemiBold" Margin="0,0,12,4" />
            <Button Content="✓ Aceptar sugerencia" Command="{Binding AcceptSuggestionCommand}"
                    IsEnabled="{Binding SelectedRow.HasSuggestion, FallbackValue=False}"
                    Background="#059669" Foreground="White" FontWeight="SemiBold" Margin="0,0,12,4"
                    ToolTip.Tip="Renombra el archivo y escribe artista y título con lo que propone la IA local. Ningún catálogo lo ha confirmado: repasa antes la columna «Sugerencia de la IA». Se puede deshacer desde el historial." />
            <Button Content="⯆ Desplegar todo" Click="ExpandAll_Click" Margin="0,0,6,4" />
            <Button Content="⯈ Cerrar todo" Click="CollapseAll_Click" Margin="0,0,6,4" />
            <TextBox Text="{Binding Busqueda}" PlaceholderText="Buscar…" Width="180" Margin="6,0,4,4"
                     ToolTip.Tip="Filtra por archivo, carpeta, búsqueda usada o sugerencia de la IA. Por palabras sueltas y en cualquier orden." />
            <TextBlock Text="{Binding FiltroInfo}" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,6,4" />
            <Border IsVisible="{Binding SeleccionadasInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="#1E3A8A" CornerRadius="4" Padding="8,3" Margin="0,0,6,4" VerticalAlignment="Center">
                <TextBlock Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"
                           Text="{Binding SeleccionadasInfo, StringFormat='{}{0} · clic derecho para actuar sobre todas'}" />
            </Border>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </WrapPanel>
        <ProgressBar DockPanel.Dock="Top" Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6"
                     IsVisible="{Binding IsBusy}" Margin="0,0,0,6" />

        <DataGrid Name="Grid" ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}"
                  SelectionMode="Extended" SelectionChanged="Grid_SelectionChanged"
                  x:CompileBindings="False" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                  PointerPressed="Grid_PointerPressed" DoubleTapped="Grid_DoubleTapped">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Aceptar la sugerencia de la IA" Command="{Binding AcceptSuggestionCommand}"
                              ToolTip.Tip="Renombra y etiqueta con lo que propone la IA local. Nadie lo ha confirmado: repásalo antes." />
                    <MenuItem Header="Escuchar / Parar" Command="{Binding PlayPreviewCommand}" />
                    <MenuItem Header="Editar esta canción" Command="{Binding EditThisCommand}" />
                    <MenuItem Header="Reanalizar…" Click="Reanalyze_Click"
                              ToolTip.Tip="Corrige la búsqueda, elige entre las coincidencias, pega un enlace o identifica por huella. Si aparece, se aplica." />
                    <MenuItem Header="Quitar de la lista (descartar)" Command="{Binding DiscardSelectedCommand}"
                              ToolTip.Tip="No volverá a aparecer ni aquí ni en Enriquecer. Se recupera desde Ajustes." />
                    <Separator />
                    <MenuItem Header="Abrir carpeta contenedora" Command="{Binding OpenContainingFolderCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Archivo" Binding="{Binding FileName}" Width="2*" MinWidth="150" />
                <DataGridTextColumn Header="Sugerencia de la IA" Binding="{Binding Suggestion}" Width="2*" MinWidth="150" />
                <DataGridTextColumn Header="Búsqueda usada" Binding="{Binding Query}" Width="1.5*" MinWidth="120" />
                <DataGridTextColumn Header="Carpeta" Binding="{Binding Folder}" Width="1.5*" MinWidth="120" />
                <DataGridTextColumn Header="Estado" Binding="{Binding RowStatus}" Width="140" MinWidth="90" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
