<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Etiquetador.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="560"
             x:Class="Etiquetador.App.Views.IncompleteView"
             x:DataType="vm:IncompleteViewModel">

    <DockPanel Margin="8">

        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
            <TextBlock Classes="titulo" Text="Fichas incompletas" />
            <TextBlock Classes="desc"
                       Text="Canciones a las que les falta alguna etiqueta: artista, título, álbum, año, género o carátula. Son las que aparecen sin datos en los reproductores." />
        </StackPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button Content="Analizar" Command="{Binding AnalyzeCommand}" IsEnabled="{Binding !IsBusy}"
                    Background="#2563EB" Foreground="White" FontWeight="SemiBold" Margin="0,0,12,4" />
            <Button Content="⯆ Desplegar todo" Click="ExpandAll_Click" Margin="0,0,6,4" />
            <Button Content="⯈ Cerrar todo" Click="CollapseAll_Click" Margin="0,0,6,4" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </WrapPanel>
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" Margin="0,0,0,6" />

        <DataGrid Name="Grid" ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}"
                  x:CompileBindings="False" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                  PointerPressed="Grid_PointerPressed" DoubleTapped="Grid_DoubleTapped">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Editar esta canción" Command="{Binding EditThisCommand}" />
                    <MenuItem Header="Reanalizar (y aplicar si aparece)" Command="{Binding ReanalyzeThisCommand}" />
                    <MenuItem Header="Escuchar / Parar" Command="{Binding PlayPreviewCommand}" />
                    <Separator />
                    <MenuItem Header="Abrir carpeta contenedora" Command="{Binding OpenContainingFolderCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Archivo" Binding="{Binding FileName}" Width="2*" MinWidth="150" />
                <DataGridTextColumn Header="Faltan" Binding="{Binding Missing}" Width="160" MinWidth="120" />
                <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="1.5*" MinWidth="90" />
                <DataGridTextColumn Header="Artista" Binding="{Binding Artist}" Width="1.2*" MinWidth="80" />
                <DataGridTextColumn Header="Género" Binding="{Binding Genre}" Width="90" MinWidth="60" />
                <DataGridTextColumn Header="Año" Binding="{Binding Year}" Width="55" MinWidth="45" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
