<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="300"
        x:Class="Etiquetador.App.Views.SearchDialog"
        Title="Reanalizar — buscar concretamente"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <StackPanel Margin="18" Spacing="10">
        <TextBlock Text="¿Qué buscamos?" FontSize="16" FontWeight="Bold" />
        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12"
                   Text="Corrige el artista y el título para afinar la búsqueda en las fuentes. Se usa solo para esta canción." />

        <TextBlock Text="Archivo" FontWeight="Bold" Margin="0,6,0,0" />
        <TextBlock x:Name="FileText" TextWrapping="Wrap" Foreground="Gray" FontSize="12" />

        <TextBlock Text="Artista" FontWeight="Bold" Margin="0,6,0,0" />
        <TextBox x:Name="ArtistBox" PlaceholderText="Ej: Daft Punk" KeyDown="OnKeyDown" />

        <TextBlock Text="Título" FontWeight="Bold" />
        <TextBox x:Name="TitleBox" PlaceholderText="Ej: One More Time" KeyDown="OnKeyDown" />

        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,2,0,0"
                   Text="Consejo: añade (Remix), (Extended) o (Live) al título si quieres esa versión concreta. Deja un campo vacío para que se deduzca del nombre del archivo." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Cancelar" Click="Cancel_Click" MinWidth="90" />
            <Button Content="Buscar" Click="Ok_Click" MinWidth="90"
                    Background="#7C3AED" Foreground="White" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
