<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Etiquetador.App.App"
             xmlns:local="using:Etiquetador.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://BeatTag/Tema.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!--
            Cabecera de pestaña. Se define aquí, y no en cada vista, para que todas se vean
            igual: cambiar el aspecto en un sitio lo cambia en las doce.
            Uso:  <TextBlock Classes="titulo" Text="…" />
                  <TextBlock Classes="desc"   Text="…" />
        -->
        <Style Selector="TextBlock.titulo">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="TextBlock.desc">
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <!--
            Altura de fila de TODAS las tablas, desde un solo sitio. El ajuste de densidad cambia
            el recurso en caliente y con DynamicResource lo recogen las dieciocho vistas sin que
            haya que tocar ninguna.
        -->
        <Style Selector="DataGrid">
            <Setter Property="RowHeight" Value="{DynamicResource FilaAltura}" />
        </Style>

        <!--
            Un botón de la barra lateral. Se le da forma aquí para no repetirla trece veces.
            El margen no es adorno: sin él los trece botones se tocan y el fondo del activo llega
            pegado al borde de la barra, así que no se lee como un elemento suelto sino como una
            franja. Con aire alrededor, el resaltado del activo se ve como lo que es.
        -->
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.nav.activa">
            <Setter Property="Background" Value="{DynamicResource NavActivo}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.nav:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!-- Título de un grupo de la barra lateral. -->
        <Style Selector="TextBlock.grupo">
            <Setter Property="Foreground" Value="{DynamicResource NavGrupo}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <!-- 14 a la izquierda: justo donde empieza el contenido del botón (4 de margen + 10 de relleno). -->
            <Setter Property="Margin" Value="14,14,8,4" />
        </Style>
    </Application.Styles>
</Application>